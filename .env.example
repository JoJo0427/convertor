# Port the workspace is served on.
CONVERTOR_PORT=3000

# Largest single file that can be added, in megabytes.
CONVERTOR_MAX_UPLOAD_MB=2048

# How many files convert at the same time inside one batch.
CONVERTOR_CONCURRENCY=3

# Phase 4 intelligent workflows (document repair, image-to-document, translation,
# briefs). Leave blank to keep them switched off — every other conversion runs
# entirely on this machine and needs nothing here.
#
# These specific conversions send file contents to Anthropic's API.
ANTHROPIC_API_KEY=
CONVERTOR_AI_MODEL=claude-opus-5
